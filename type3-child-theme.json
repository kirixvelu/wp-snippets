{
  "version": 3,
  "settings": {
    "typography": {
      "fontFamilies": [
        {
          "name": "System Serif",
          "slug": "system-serif",
          "fontFamily": "Charter, 'Bitstream Charter', 'Sitka Text', Cambria, Georgia, serif"
        },
        {
          "name": "System Sans",
          "slug": "system-sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
        }
      ]
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-serif)"
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--system-sans)"
        }
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--system-sans)"
        }
      },
      "button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--system-sans)"
        }
      }
    }
  }
}
