{
  "_childtheme": "2025 Child Theme Dark Mode Configuration",
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "base",
          "color": "light-dark(#ffffff, #111111)",
          "name": "Base"
        },
        {
          "slug": "contrast",
          "color": "light-dark(#111111, #ffffff)",
          "name": "Contrast"
        },
        {
          "slug": "accent-1",
          "color": "light-dark(#FFEE58, #E6D64A)",
          "name": "Accent 1"
        },
        {
          "slug": "accent-2",
          "color": "light-dark(#F6CFF4, #D4A8D0)",
          "name": "Accent 2"
        },
        {
          "slug": "accent-3",
          "color": "light-dark(#503AA8, #7B6BC4)",
          "name": "Accent 3"
        },
        {
          "slug": "accent-4",
          "color": "light-dark(#686868, #999999)",
          "name": "Accent 4"
        },
        {
          "slug": "accent-5",
          "color": "light-dark(#FBFAF3, #3A3A35)",
          "name": "Accent 5"
        },
        {
          "slug": "accent-6",
          "color": "color-mix(in srgb, currentColor 20%, transparent)",
          "name": "Accent 6"
        }
      ]
    }
  },
  "styles": {
    "css": ":root { color-scheme: light dark; }"
  }
}
